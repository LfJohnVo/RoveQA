{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roveqa.dev/schemas/memory-context.v1.json",
  "title": "RoveQA Retrieved Memory Context",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "query_id",
    "project_id",
    "environment_id",
    "items"
  ],
  "properties": {
    "schema_version": {
      "const": "roveqa.memory-context.v1"
    },
    "query_id": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "environment_id": {
      "type": "string",
      "minLength": 1
    },
    "items": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "memory_id",
          "kind",
          "summary",
          "observed",
          "model_derived",
          "reliability",
          "freshness",
          "validity",
          "compatibility",
          "provenance",
          "selection_reason"
        ],
        "properties": {
          "memory_id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "observed": {
            "type": "boolean",
            "description": "True when the item derives from deterministic verified observation. Mirrors knowledge-experience.v1; the label must survive retrieval so the planner never treats an LLM hypothesis as an observed fact."
          },
          "model_derived": {
            "type": "boolean",
            "description": "True when the item originates from a model hypothesis. Must never be silently dropped or coerced to observed."
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "reliability": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "freshness": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "validity": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "valid_from",
              "valid_to",
              "last_verified_at"
            ],
            "properties": {
              "valid_from": {
                "type": "string",
                "format": "date-time"
              },
              "valid_to": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time"
              },
              "last_verified_at": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time"
              }
            }
          },
          "compatibility": {
            "enum": [
              "exact",
              "compatible",
              "revalidate",
              "incompatible"
            ]
          },
          "provenance": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source_run_id",
              "candidate_id"
            ],
            "properties": {
              "source_run_id": {
                "type": "string",
                "minLength": 1
              },
              "candidate_id": {
                "type": "string",
                "minLength": 1
              },
              "evidence_set_id": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          "selection_reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        }
      }
    }
  }
}
