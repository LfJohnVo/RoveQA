{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RunEvent",
  "type": "object",
  "required": [
    "event_id",
    "run_id",
    "type",
    "occurred_at",
    "sequence",
    "payload"
  ],
  "properties": {
    "event_id": {
      "type": "string"
    },
    "run_id": {
      "type": "string"
    },
    "type": {
      "type": "string"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "payload": {
      "type": "object"
    },
    "artifact_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
