APP_ENV=development
APP_LOG_LEVEL=INFO
POSTGRES_DSN=postgresql+asyncpg://agentic:agentic@postgres:5432/agentic_qa
REDIS_URL=redis://redis:6379/0
TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=agentic-qa
FALKORDB_HOST=falkordb
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
ARTIFACT_ROOT=/data/runs
BROWSER_STATE_ROOT=/data/browser-state
# Inference (Phase 06). Leave VLLM_BASE_URL empty to run the stack without a model:
# the worker starts and reports that no agent runtime is configured.
# Server root, with or without /v1. The model tag depends on the GPU of the host that
# runs it, so it is set here rather than pinned in compose.
VLLM_BASE_URL=http://vllm:8000
VLLM_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
VLLM_MAX_MODEL_LEN=16384
# Parallel calls the model server can serve. Enforced across workers via Redis.
MODEL_MAX_CONCURRENCY=2
MODEL_TIMEOUT_SECONDS=60
AIRLLM_BASE_URL=http://airllm:8100
AIRLLM_MODEL=configure-me
ALLOWED_TARGET_ORIGINS=http://host.docker.internal:3000

# Adaptive learning graph (Phase 09)
GRAPH_MEMORY_ENABLED=true
FALKORDB_DATABASE=roveqa_memory
MEMORY_MAX_RETRIEVAL_ITEMS=20
MEMORY_STALE_AFTER_DAYS=30
VLLM_EMBED_BASE_URL=http://vllm-embed:8000/v1
VLLM_EMBED_MODEL=configure-embedding-model
