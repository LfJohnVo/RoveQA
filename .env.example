APP_ENV=development
APP_LOG_LEVEL=INFO
POSTGRES_DSN=postgresql+asyncpg://agentic:agentic@postgres:5432/agentic_qa
REDIS_URL=redis://redis:6379/0
TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=agentic-qa
ARTIFACT_ROOT=/data/runs
BROWSER_STATE_ROOT=/data/browser-state
ALLOWED_TARGET_ORIGINS=http://host.docker.internal:3000

# ---------------------------------------------------------------------------------
# Generation model (Phase 06)
# ---------------------------------------------------------------------------------
# VLLM_MODEL is the single place the model is chosen. Compose serves it, the worker
# calls it, and the optional real-model tests read the same variable — so there is one
# answer to "which model produced this result" rather than three that can disagree.
#
# Leave VLLM_BASE_URL empty to run the stack without a model: the worker starts and
# reports that no agent runtime is configured instead of faking decisions.
VLLM_BASE_URL=http://vllm:8000
VLLM_MODEL=Qwen/Qwen3-4B-Instruct-2507

# What fits a 16GB card (measured on an RTX 5060 Ti, sm_120):
#
#   Qwen/Qwen3-4B-Instruct-2507        ~8GB   default; leaves room for a long context
#   Qwen/Qwen3-8B                      ~16GB  needs VLLM_MAX_MODEL_LEN=8192 and eager
#   Qwen/Qwen3-14B-AWQ                 ~9GB   quantized; set VLLM_QUANTIZATION=awq
#   Qwen/Qwen3-32B-AWQ                 ~19GB  does not fit 16GB
#
# Weights are only part of it: KV cache grows with VLLM_MAX_MODEL_LEN × VLLM_MAX_NUM_SEQS,
# so a bigger model usually means lowering one of those rather than raising utilisation.
VLLM_MAX_MODEL_LEN=16384
VLLM_GPU_MEMORY_UTILIZATION=0.85
# Parallel sequences the server admits. Keep it equal to MODEL_MAX_CONCURRENCY:
# admitting more than the client will ever send reserves KV cache nobody uses.
VLLM_MAX_NUM_SEQS=4

# Empty means not quantized. `awq` or `gptq` is what puts a 14B-class model on 16GB —
# match the value to the checkpoint, not to a preference.
VLLM_QUANTIZATION=
# Any non-empty value skips CUDA graph capture: slower per request, and it frees the
# memory the capture needs. Often the difference between a large model loading and
# failing at startup.
VLLM_ENFORCE_EAGER=
# Escape hatch for anything else (`--kv-cache-dtype fp8`, `--swap-space 2`, …), passed
# through verbatim. A variable per flag would age badly; this does not.
VLLM_EXTRA_ARGS=
# Raise it when a first boot has more weights to download than the default allows.
# A slow first boot is not a failed one.
VLLM_START_PERIOD=600s
VLLM_IMAGE=vllm/vllm-openai:v0.27.1-cu129

# Parallel calls the model server can actually serve. Enforced across workers via Redis.
MODEL_MAX_CONCURRENCY=2
MODEL_TIMEOUT_SECONDS=60

# ---------------------------------------------------------------------------------
# Adaptive learning graph (Phase 09)
# ---------------------------------------------------------------------------------
# Leave FALKORDB_URL empty to run without the projection: memory is then served from
# PostgreSQL alone, which loses traversal and semantic recall and nothing else. There is
# no separate on/off flag — an absent URL is the off switch, so a deployment cannot end
# up "enabled" with nowhere to write.
FALKORDB_URL=redis://falkordb:6379
GRAPH_DATABASE=roveqa
FALKORDB_IMAGE=falkordb/falkordb:v4.20.3
# Graphiti's telemetry is opt-out. A local-first deployment does not report how much
# memory it is building to a third party.
GRAPHITI_TELEMETRY_ENABLED=false

# Embeddings, for semantic retrieval over learned memory. A pooling server separate
# from the generation one (ADR 0008): sharing one endpoint would make every embedding
# queue behind the planner.
#
# EMBEDDING_BASE_URL empty = no semantic search. The graph still answers by text and the
# deterministic ranking in PostgreSQL is unaffected, so this is a real option rather
# than a degraded one. Never point it at the chat endpoint: a chat model asked for
# embeddings either refuses or returns vectors that are not comparable to what the rest
# of the graph was built with.
#
# To turn it on: start the server and point the URL at it.
#   docker compose --profile memory-gpu up -d vllm-embed
#   EMBEDDING_BASE_URL=http://vllm-embed:8000
# On a single-GPU host it competes with `vllm` for the card, which is why it has its
# own profile and a small memory share.
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_MAX_MODEL_LEN=8192
EMBEDDING_GPU_MEMORY_UTILIZATION=0.10
EMBEDDING_EXTRA_ARGS=

# ---------------------------------------------------------------------------------
# Deep analysis (Phase 11)
# ---------------------------------------------------------------------------------
# Cold-path reasoning about failure clusters. Never on the browser loop: this model
# answers in minutes, and the per-action planner uses VLLM_BASE_URL above.
#
# DEEP_BASE_URL empty = no deep analysis. Failures are still grouped deterministically,
# the clusters are still stored and reported, and every cluster simply arrives with no
# hypothesis. That is a complete report, not a degraded one — which is why there is no
# separate on/off flag.
#
# To turn it on, start a second server and point the URL at it:
#   docker compose --profile deep-gpu up -d vllm-deep
#   DEEP_BASE_URL=http://vllm-deep:8000
#   DEEP_MODEL=Qwen/Qwen3-14B-AWQ
# On a single-GPU host it competes with `vllm` for the card, so run them sequentially
# (analysis happens after runs finish) or put this one on another machine.
#
# Any OpenAI-compatible server works, including an AirLLM shim for a model far larger
# than the card — expect minutes per answer and raise DEEP_TIMEOUT_SECONDS to match.
DEEP_BASE_URL=
DEEP_MODEL=Qwen/Qwen3-14B-AWQ
DEEP_MAX_MODEL_LEN=16384
DEEP_GPU_MEMORY_UTILIZATION=0.90
# AWQ/GPTQ is what puts a 14B-class model on 16GB. Empty means not quantized.
DEEP_QUANTIZATION=awq_marlin
# Non-empty skips CUDA graph capture: slower per token, and often the difference
# between a large model loading and OOMing at startup.
DEEP_ENFORCE_EAGER=1
DEEP_EXTRA_ARGS=
# Minutes, not seconds. A deep answer that takes ten minutes is expected behaviour;
# the run it explains is already finished and its verdict is already durable.
DEEP_TIMEOUT_SECONDS=900
DEEP_MAX_OUTPUT_TOKENS=800
